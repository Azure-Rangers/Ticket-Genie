    AvgDurationMs = avg(duration),
    P95DurationMs = percentiles(duration, 95)[0],
    ServerError5xx = countif(toint(resultCode) >= 500),
    ClientError4xx = countif(toint(resultCode) >= 400 and toint(resultCode) < 500)
  by bin(timestamp, 5m)
| render timechart


// Route: GET /api/users/upper-management (users)

requests
| where timestamp > ago(1h) and name == "GET /api/users/upper-management"
| summarize
    RequestVolume = count(),
    AvgDurationMs = avg(duration),
    P95DurationMs = percentiles(duration, 95)[0],
    ServerError5xx = countif(toint(resultCode) >= 500),
    ClientError4xx = countif(toint(resultCode) >= 400 and toint(resultCode) < 500)
  by bin(timestamp, 5m)
| render timechart


